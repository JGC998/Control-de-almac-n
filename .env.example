DATABASE_URL="file:./prisma/dev.db"   # SQLite en dev; MySQL en prod (mysql://user:pass@host/db)

# Autenticación — opcional (si no se configura AUTH_PIN la app es pública)
# AUTH_PIN="1234"
# SESSION_SECRET="cambia-esto-por-un-secreto-aleatorio-en-produccion"

# Email via Resend (OBLIGATORIO para envío de presupuestos/pedidos por correo)
RESEND_API_KEY=""
RESEND_FROM="CRM Taller <noreply@tu-dominio.com>"

# =============================================================================
# TRACKING DE CONTENEDORES (Ship24 + CallMeBot WhatsApp)
# =============================================================================

# Ship24 — tracking multi-naviera gratuito
# Regístrate en https://ship24.com → Dashboard → API Keys → Copy Free Key
SHIP24_API_KEY=""

# CallMeBot — WhatsApp gratuito al número configurado
# Activación (1 vez, 2 min):
#   1. Añade el contacto +34 644 59 11 21 en tu WhatsApp
#   2. Envíale el mensaje exacto: I allow callmebot to send me messages
#   3. Recibirás un mensaje con tu apikey
CALLMEBOT_PHONE="34612345678"   # Tu número SIN el + (ej: 34612345678)
CALLMEBOT_APIKEY=""             # El apikey que te envió CallMeBot
