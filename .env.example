DATABASE_URL="file:./prisma/dev.db"   # SQLite en dev; MySQL en prod (mysql://user:pass@host/db)

# Autenticación (OBLIGATORIO en producción — sin AUTH_PIN el servidor devuelve 503)
AUTH_PIN="1234"

# Secreto para firma HMAC de la cookie de sesión (OBLIGATORIO en producción)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambia-esto-por-un-secreto-aleatorio-en-produccion"

# Email via Resend (OBLIGATORIO para envío de presupuestos/pedidos por correo)
RESEND_API_KEY=""
RESEND_FROM="CRM Taller <noreply@tu-dominio.com>"
